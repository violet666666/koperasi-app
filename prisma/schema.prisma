// This file is intentionally empty, will be populated by prisma init
// Prisma schema location: prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =================================================================
// AUTHENTICATION & USERS
// =================================================================

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String    @unique
  password        String
  roleId          Int       @map("role_id")
  branchId        Int?      @map("branch_id")
  memberId        Int?      @unique @map("member_id")
  unitType        String?   @map("unit_type") // simpan_pinjam, toko, fitness, cuci_mobil, fotocopy, laundry, resto_cafe, playstation, barbershop, aset
  fcmToken        String?   @map("fcm_token")
  isActive        Boolean   @default(true) @map("is_active")
  emailVerifiedAt DateTime? @map("email_verified_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  role   Role    @relation(fields: [roleId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])
  member Member? @relation("UserMember", fields: [memberId], references: [id])

  // Relations
  createdMembers          Member[]              @relation("MemberCreatedBy")
  savingsTransactions     SavingsTransaction[]  @relation("SavingsCreatedBy")
  loanApplicationsCreated LoanApplication[]     @relation("LoanAppCreatedBy")
  loanApplicationsApproved LoanApplication[]    @relation("LoanAppApprovedBy")
  loanPayments            LoanPayment[]         @relation("PaymentCreatedBy")
  cashBankTransactions    CashBankTransaction[] @relation("CashBankCreatedBy")
  approvalRequests        ApprovalRequest[]     @relation("ApprovalRequestedBy")
  approvedRequests        ApprovalRequest[]     @relation("ApprovalApprovedBy")
  journals                Journal[]             @relation("JournalCreatedBy")
  unitTransactions        UnitTransaction[]     @relation("UnitTxCreatedBy")
  storeSalesCreated       StoreSale[]           @relation("StoreSaleCreatedBy")
  receiptsCreated         Receipt[]             @relation("ReceiptCreatedBy")
  announcements           Announcement[]        @relation("AnnouncementAuthor")
  auditLogs               AuditLog[]            @relation("AuditLogUser")
  unitServicePackages     UnitServicePackage[]
  storeStockMovements     StoreStockMovement[]  @relation("stockMovementOperator")
  stockMovementsVoided    StoreStockMovement[]  @relation("stockMovementVoidedBy")
  uploadedFiles           UploadedFile[]        @relation("FileUploadedBy")
  cashierShifts           CashierShift[]        @relation("CashierShiftUser")
  cashierIdentities       CashierIdentity[]
  notifications           Notification[]

  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  displayName String   @map("display_name")
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  displayName String   @map("display_name")
  module      String
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// =================================================================
// MASTER DATA
// =================================================================

model Branch {
  id           Int       @id @default(autoincrement())
  code         String    @unique
  name         String
  address      String?
  phone        String?
  email        String?
  isHeadOffice Boolean   @default(false) @map("is_head_office")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  users               User[]
  members             Member[]
  savingsAccounts     SavingsAccount[]
  savingsTransactions SavingsTransaction[]
  loanApplications    LoanApplication[]
  loans               Loan[]
  cashBankAccounts    CashBankAccount[]
  cashBankTransactions CashBankTransaction[]
  journals            Journal[]
  approvalRequests    ApprovalRequest[]

  @@map("branches")
}

model SavingsProduct {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  name          String
  type          String    // pokok, wajib, sukarela, lainnya
  isMandatory   Boolean   @default(false) @map("is_mandatory")
  depositPeriod String?   @map("deposit_period") // once, monthly, optional
  minimumAmount Decimal   @default(0) @map("minimum_amount") @db.Decimal(15, 2)
  canWithdraw   Boolean   @default(true) @map("can_withdraw")
  glAccountId   Int?      @map("gl_account_id")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  glAccount       Account?         @relation(fields: [glAccountId], references: [id])
  savingsAccounts SavingsAccount[]

  @@map("savings_products")
}

model LoanProduct {
  id                    Int       @id @default(autoincrement())
  code                  String
  name                  String
  version               Int       @default(1)
  interestMethod        String    @map("interest_method") // flat, effective, annuity
  interestRate          Decimal   @map("interest_rate") @db.Decimal(5, 2)
  interestCalculation   String?   @map("interest_calculation") // monthly, daily
  minTenorMonths        Int?      @map("min_tenor_months")
  maxTenorMonths        Int?      @map("max_tenor_months")
  minAmount             Decimal?  @map("min_amount") @db.Decimal(15, 2)
  maxAmount             Decimal?  @map("max_amount") @db.Decimal(15, 2)
  adminFeeType          String?   @map("admin_fee_type") // percent, fixed
  adminFeeValue         Decimal?  @map("admin_fee_value") @db.Decimal(15, 2)
  lateFeeType           String?   @map("late_fee_type")
  lateFeeValue          Decimal?  @map("late_fee_value") @db.Decimal(15, 2)
  gracePeriodDays       Int       @default(0) @map("grace_period_days")
  requiresCollateral    Boolean   @default(false) @map("requires_collateral")
  maxLoanToSavingsRatio Decimal?  @map("max_loan_to_savings_ratio") @db.Decimal(5, 2)
  effectiveDate         DateTime  @map("effective_date") @db.Date
  isCurrent             Boolean   @default(true) @map("is_current")
  isActive              Boolean   @default(true) @map("is_active")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  loanApplications LoanApplication[]

  @@unique([code, version])
  @@map("loan_products")
}

model Account {
  id            Int       @id @default(autoincrement())
  code          String    @unique
  name          String
  type          String    // asset, liability, equity, income, expense
  category      String?
  parentId      Int?      @map("parent_id")
  level         Int
  isDetail      Boolean   @default(true) @map("is_detail")
  normalBalance String    @map("normal_balance") // debit, credit
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  parent           Account?         @relation("AccountParent", fields: [parentId], references: [id])
  children         Account[]        @relation("AccountParent")
  savingsProducts  SavingsProduct[]
  cashBankAccounts CashBankAccount[]
  journalLines     JournalLine[]

  @@map("accounts")
}

// =================================================================
// MEMBERS
// =================================================================

model Member {
  id                Int       @id @default(autoincrement())
  memberNo          String    @unique @map("member_no")
  nrp               String?   @unique
  branchId          Int       @map("branch_id")
  name              String
  nik               String?   @unique
  gender            String?
  birthDate         DateTime? @map("birth_date") @db.Date
  birthPlace        String?   @map("birth_place")
  maritalStatus     String?   @map("marital_status")
  religion          String?
  education         String?
  pangkat           String?   @map("occupation")  // Pangkat Polri (IPTU, AKP, Aipda, dll) — DB column: occupation
  golongan          String?                       // Golongan kepangkatan (I/a – IV/e)
  kesatuan          String?                       // Unit kerja (Sat Reskrim, Bag Ops, dll)
  phone             String?
  email             String?
  address           String?
  rt                String?
  rw                String?
  village           String?
  district          String?
  city              String?
  province          String?
  postalCode        String?   @map("postal_code")
  joinDate          DateTime  @map("join_date") @db.Date
  category          String?                       // Polri, PNS, Karyawan, dll (legacy — gradually replaced by employeeType)
  employeeType      String?   @map("employee_type")  // organik_polri, pns_polri, purnawirawan, masyarakat_umum
  noRekening        String?   @map("no_rekening")    // No rekening BRI untuk mass debet
  salary            Decimal?  @map("salary") @db.Decimal(15, 2) // Monthly salary for loan eligibility
  tunlesKinerja     Decimal?  @map("tunles_kinerja") @db.Decimal(15, 2) // Tunjangan Kinerja (Tunkin)
  tabunganWajib     Decimal?  @map("tabungan_wajib") @db.Decimal(15, 2) // Tabungan Wajib per bulan
  plafonPiutang     Decimal   @default(0) @map("plafon_piutang") @db.Decimal(15, 2) // Limit piutang di unit usaha — hanya bisa diubah Operator
  status            String    @default("active") // active, inactive, resigned
  resignedDate      DateTime? @map("resigned_date") @db.Date
  resignationReason String?   @map("resignation_reason")
  photoPath         String?   @map("photo_path")
  idCardPath        String?   @map("id_card_path")
  createdById       Int?      @map("created_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  branch              Branch               @relation(fields: [branchId], references: [id])
  createdBy           User?                @relation("MemberCreatedBy", fields: [createdById], references: [id])
  userAccount         User?                @relation("UserMember")
  savingsAccounts     SavingsAccount[]
  savingsTransactions SavingsTransaction[]
  loanApplications    LoanApplication[]
  loans               Loan[]
  loanPayments        LoanPayment[]
  unitTransactions    UnitTransaction[]
  storeSales          StoreSale[]
  receipts            Receipt[]
  tabunganSejahteraHistory TabunganSejahteraHistory[]
  cashBankTransactions CashBankTransaction[] @relation("CashBankMember")
  shuDistributions     ShuDistribution[]

  @@index([status])
  @@index([nrp])
  @@index([deletedAt])
  @@map("members")
}

// =================================================================
// SISA HASIL USAHA (SHU)
// =================================================================

model ShuPeriod {
  id              Int               @id @default(autoincrement())
  year            Int               @unique
  status          String            @default("calculated") // calculated, distributed
  totalIncome     Decimal           @default(0) @map("total_income") @db.Decimal(15, 2)
  totalExpense    Decimal           @default(0) @map("total_expense") @db.Decimal(15, 2)
  netSurplus      Decimal           @default(0) @map("net_surplus") @db.Decimal(15, 2)
  memberDividend  Decimal           @default(0) @map("member_dividend") @db.Decimal(15, 2)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  distributions   ShuDistribution[]

  @@map("shu_periods")
}

model ShuDistribution {
  id              Int       @id @default(autoincrement())
  periodId        Int       @map("period_id")
  memberId        Int       @map("member_id")
  modalPortion    Decimal   @default(0) @map("modal_portion") @db.Decimal(15, 2)
  usahaPortion    Decimal   @default(0) @map("usaha_portion") @db.Decimal(15, 2)
  totalAmount     Decimal   @default(0) @map("total_amount") @db.Decimal(15, 2)
  status          String    @default("pending") // pending, transferred, savings_credited
  distributedAt   DateTime? @map("distributed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  period          ShuPeriod @relation(fields: [periodId], references: [id])
  member          Member    @relation(fields: [memberId], references: [id])

  @@unique([periodId, memberId])
  @@map("shu_distributions")
}

// =================================================================
// TABUNGAN SEJAHTERA (Historical Data Only)
// =================================================================

model TabunganSejahteraHistory {
  id        Int      @id @default(autoincrement())
  memberId  Int      @map("member_id")
  tahun     Int
  bulan     Int      // 1-12
  kasMasuk   Decimal   @default(0) @map("kas_masuk") @db.Decimal(15, 2)
  kasKeluar  Decimal   @default(0) @map("kas_keluar") @db.Decimal(15, 2)
  saldoAkhir Decimal   @default(0) @map("saldo_akhir") @db.Decimal(15, 2)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  member    Member   @relation(fields: [memberId], references: [id])

  // Optional: Add index or unique block
  @@unique([memberId, tahun, bulan])
  @@map("tabungan_sejahtera_history")
}

// =================================================================
// SAVINGS
// =================================================================

model SavingsAccount {
  id         Int       @id @default(autoincrement())
  accountNo  String    @unique @map("account_no")
  memberId   Int       @map("member_id")
  productId  Int       @map("product_id")
  branchId   Int       @map("branch_id")
  balance    Decimal   @default(0) @db.Decimal(15, 2)
  status     String    @default("active") // active, closed
  openedDate DateTime  @map("opened_date") @db.Date
  closedDate DateTime? @map("closed_date") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  member       Member               @relation(fields: [memberId], references: [id])
  product      SavingsProduct       @relation(fields: [productId], references: [id])
  branch       Branch               @relation(fields: [branchId], references: [id])
  transactions SavingsTransaction[]

  @@unique([memberId, productId])
  @@map("savings_accounts")
}

model SavingsTransaction {
  id                Int       @id @default(autoincrement())
  transactionNo     String    @unique @map("transaction_no")
  accountId         Int       @map("account_id")
  memberId          Int       @map("member_id")
  productId         Int       @map("product_id")
  branchId          Int       @map("branch_id")
  type              String    // deposit, withdrawal, correction, interest
  amount            Decimal   @db.Decimal(15, 2)
  balanceBefore     Decimal   @map("balance_before") @db.Decimal(15, 2)
  balanceAfter      Decimal   @map("balance_after") @db.Decimal(15, 2)
  paymentMethod     String?   @map("payment_method") // cash, bank_transfer
  cashBankAccountId Int?      @map("cash_bank_account_id")
  referenceNo       String?   @map("reference_no")
  notes             String?
  transactionDate   DateTime  @map("transaction_date") @db.Date
  journalId         Int?      @map("journal_id")
  periodId          Int?      @map("period_id")
  status            String    @default("completed") // completed, voided
  voidedAt          DateTime? @map("voided_at")
  voidedById        Int?      @map("voided_by_id")
  voidReason        String?   @map("void_reason")
  createdById       Int       @map("created_by_id")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  account         SavingsAccount   @relation(fields: [accountId], references: [id])
  member          Member           @relation(fields: [memberId], references: [id])
  branch          Branch           @relation(fields: [branchId], references: [id])
  cashBankAccount CashBankAccount? @relation(fields: [cashBankAccountId], references: [id])
  journal         Journal?         @relation(fields: [journalId], references: [id])
  period          FiscalPeriod?    @relation(fields: [periodId], references: [id])
  createdBy       User             @relation("SavingsCreatedBy", fields: [createdById], references: [id])

  @@index([transactionDate])
  @@index([type, transactionDate])
  @@index([accountId])
  @@map("savings_transactions")
}

// =================================================================
// LOANS
// =================================================================

model LoanApplication {
  id                    Int       @id @default(autoincrement())
  applicationNo         String    @unique @map("application_no")
  memberId              Int       @map("member_id")
  branchId              Int       @map("branch_id")
  productId             Int       @map("product_id")
  amount                Decimal   @db.Decimal(15, 2)
  tenorMonths           Int       @map("tenor_months")
  purpose               String?
  collateralDescription String?   @map("collateral_description")
  notes                 String?
  status                String    @default("draft") // draft, submitted, approved, rejected, disbursed, cancelled
  deductionSource       String    @default("gaji") @map("deduction_source") // gaji, tunkin, bs(bayar sendiri)
  submittedAt           DateTime? @map("submitted_at")
  approvedAt            DateTime? @map("approved_at")
  approvedById          Int?      @map("approved_by_id")
  rejectedAt            DateTime? @map("rejected_at")
  rejectedById          Int?      @map("rejected_by_id")
  rejectionReason       String?   @map("rejection_reason")
  createdById           Int       @map("created_by_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  member     Member      @relation(fields: [memberId], references: [id])
  branch     Branch      @relation(fields: [branchId], references: [id])
  product    LoanProduct @relation(fields: [productId], references: [id])
  createdBy  User        @relation("LoanAppCreatedBy", fields: [createdById], references: [id])
  approvedBy User?       @relation("LoanAppApprovedBy", fields: [approvedById], references: [id])
  loan       Loan?

  @@map("loan_applications")
}

model Loan {
  id                     Int       @id @default(autoincrement())
  loanNo                 String    @unique @map("loan_no")
  applicationId          Int       @unique @map("application_id")
  memberId               Int       @map("member_id")
  branchId               Int       @map("branch_id")
  productSnapshot        Json      @map("product_snapshot")
  principalAmount        Decimal   @map("principal_amount") @db.Decimal(15, 2)
  interestAmount         Decimal   @map("interest_amount") @db.Decimal(15, 2)
  totalAmount            Decimal   @map("total_amount") @db.Decimal(15, 2)
  adminFee               Decimal   @default(0) @map("admin_fee") @db.Decimal(15, 2)
  disbursedAmount        Decimal   @map("disbursed_amount") @db.Decimal(15, 2)
  tenorMonths            Int       @map("tenor_months")
  interestRate           Decimal   @map("interest_rate") @db.Decimal(5, 2)
  interestMethod         String    @map("interest_method")
  monthlyInstallment     Decimal   @map("monthly_installment") @db.Decimal(15, 2)
  principalPaid          Decimal   @default(0) @map("principal_paid") @db.Decimal(15, 2)
  interestPaid           Decimal   @default(0) @map("interest_paid") @db.Decimal(15, 2)
  lateFeePaid            Decimal   @default(0) @map("late_fee_paid") @db.Decimal(15, 2)
  principalOutstanding   Decimal   @map("principal_outstanding") @db.Decimal(15, 2)
  interestOutstanding    Decimal   @map("interest_outstanding") @db.Decimal(15, 2)
  disbursementDate       DateTime  @map("disbursement_date") @db.Date
  firstDueDate           DateTime  @map("first_due_date") @db.Date
  lastDueDate            DateTime  @map("last_due_date") @db.Date
  paidOffDate            DateTime? @map("paid_off_date") @db.Date
  status                 String    @default("active") // active, paid_off, written_off
  disbursementJournalId  Int?      @map("disbursement_journal_id")
  disbursementCashBankId Int?      @map("disbursement_cash_bank_id")
  disbursedById          Int?      @map("disbursed_by_id")
  periodId               Int?      @map("period_id")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  application          LoanApplication  @relation(fields: [applicationId], references: [id])
  member               Member           @relation(fields: [memberId], references: [id])
  branch               Branch           @relation(fields: [branchId], references: [id])
  disbursementJournal  Journal?         @relation(fields: [disbursementJournalId], references: [id])
  disbursementCashBank CashBankAccount? @relation(fields: [disbursementCashBankId], references: [id])
  period               FiscalPeriod?    @relation(fields: [periodId], references: [id])
  schedules            LoanSchedule[]
  payments             LoanPayment[]

  @@index([status])
  @@index([disbursementDate])
  @@index([memberId])
  @@map("loans")
}

model LoanSchedule {
  id              Int       @id @default(autoincrement())
  loanId          Int       @map("loan_id")
  installmentNo   Int       @map("installment_no")
  dueDate         DateTime  @map("due_date") @db.Date
  principalAmount Decimal   @map("principal_amount") @db.Decimal(15, 2)
  interestAmount  Decimal   @map("interest_amount") @db.Decimal(15, 2)
  totalAmount     Decimal   @map("total_amount") @db.Decimal(15, 2)
  principalPaid   Decimal   @default(0) @map("principal_paid") @db.Decimal(15, 2)
  interestPaid    Decimal   @default(0) @map("interest_paid") @db.Decimal(15, 2)
  lateFee         Decimal   @default(0) @map("late_fee") @db.Decimal(15, 2)
  lateFeePaid     Decimal   @default(0) @map("late_fee_paid") @db.Decimal(15, 2)
  status          String    @default("pending") // pending, partial, paid, overdue
  paidDate        DateTime? @map("paid_date") @db.Date
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  loan        Loan                      @relation(fields: [loanId], references: [id])
  allocations LoanPaymentAllocation[]

  @@unique([loanId, installmentNo])
  @@map("loan_schedules")
}

model LoanPayment {
  id                Int      @id @default(autoincrement())
  paymentNo         String   @unique @map("payment_no")
  loanId            Int      @map("loan_id")
  memberId          Int      @map("member_id")
  branchId          Int      @map("branch_id")
  amount            Decimal  @db.Decimal(15, 2)
  principalPortion  Decimal  @map("principal_portion") @db.Decimal(15, 2)
  interestPortion   Decimal  @map("interest_portion") @db.Decimal(15, 2)
  lateFeePortion    Decimal  @default(0) @map("late_fee_portion") @db.Decimal(15, 2)
  earlySettlementFee Decimal @default(0) @map("early_settlement_fee") @db.Decimal(15, 2)
  paymentType       String   @default("installment") @map("payment_type") // installment, early_settlement
  paymentMethod     String?  @map("payment_method")
  cashBankAccountId Int?     @map("cash_bank_account_id")
  referenceNo       String?  @map("reference_no")
  notes             String?
  paymentDate       DateTime @map("payment_date") @db.Date
  journalId         Int?     @map("journal_id")
  periodId          Int?     @map("period_id")
  createdById       Int      @map("created_by_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  loan            Loan                      @relation(fields: [loanId], references: [id])
  member          Member                    @relation(fields: [memberId], references: [id])
  cashBankAccount CashBankAccount?          @relation(fields: [cashBankAccountId], references: [id])
  journal         Journal?                  @relation(fields: [journalId], references: [id])
  period          FiscalPeriod?             @relation(fields: [periodId], references: [id])
  createdBy       User                      @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  allocations     LoanPaymentAllocation[]

  @@index([paymentDate])
  @@index([loanId])
  @@map("loan_payments")
}

model LoanPaymentAllocation {
  id              Int     @id @default(autoincrement())
  paymentId       Int     @map("payment_id")
  scheduleId      Int     @map("schedule_id")
  principalAmount Decimal @map("principal_amount") @db.Decimal(15, 2)
  interestAmount  Decimal @map("interest_amount") @db.Decimal(15, 2)
  lateFeeAmount   Decimal @default(0) @map("late_fee_amount") @db.Decimal(15, 2)

  payment  LoanPayment  @relation(fields: [paymentId], references: [id])
  schedule LoanSchedule @relation(fields: [scheduleId], references: [id])

  @@map("loan_payment_allocations")
}

// =================================================================
// CASH & BANK
// =================================================================

model CashBankAccount {
  id             Int       @id @default(autoincrement())
  code           String    @unique
  name           String
  type           String    // cash, bank
  bankName       String?   @map("bank_name")
  accountNumber  String?   @map("account_number")
  branchId       Int       @map("branch_id")
  glAccountId    Int?      @map("gl_account_id")
  unitType       String?   @map("unit_type") // single-unit compat: toko, fitness, cuci_mobil, dll
  unitTypes      Json?     @map("unit_types") // multi-unit: ["cuci_mobil","resto"] — overrides unitType jika diset
  purpose        String?   // "operasional" | "shu_pegawai" | "shu_cadangan" | "shu_sosial" | "shu_pengurus"
  currentBalance Decimal   @default(0) @map("current_balance") @db.Decimal(15, 2)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  branch              Branch                @relation(fields: [branchId], references: [id])
  glAccount           Account?              @relation(fields: [glAccountId], references: [id])
  transactions        CashBankTransaction[]
  savingsTransactions SavingsTransaction[]
  loanDisbursements   Loan[]
  loanPayments        LoanPayment[]

  @@map("cash_bank_accounts")
}

model CashBankTransaction {
  id            Int      @id @default(autoincrement())
  transactionNo String   @unique @map("transaction_no")
  accountId     Int      @map("account_id")
  branchId      Int      @map("branch_id")
  type          String   // in, out
  category      String?  // operational, savings, loan, transfer, other
  amount        Decimal  @db.Decimal(15, 2)
  balanceBefore Decimal  @map("balance_before") @db.Decimal(15, 2)
  balanceAfter  Decimal  @map("balance_after") @db.Decimal(15, 2)
  referenceType String?  @map("reference_type")
  referenceId   Int?     @map("reference_id")
  description   String?
  unitType      String?  @map("unit_type")     // cuci_mobil, toko, fitness, resto, dll
  memberId      Int?     @map("member_id")     // FK ke Member (opsional, untuk SHU tracking)
  transactionDate DateTime @map("transaction_date") @db.Date
  journalId     Int?     @map("journal_id")
  periodId      Int?     @map("period_id")
  createdById   Int      @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  account   CashBankAccount @relation(fields: [accountId], references: [id])
  branch    Branch          @relation(fields: [branchId], references: [id])
  member    Member?         @relation("CashBankMember", fields: [memberId], references: [id])
  journal   Journal?        @relation(fields: [journalId], references: [id])
  period    FiscalPeriod?   @relation(fields: [periodId], references: [id])
  createdBy User            @relation("CashBankCreatedBy", fields: [createdById], references: [id])

  @@index([unitType])
  @@map("cash_bank_transactions")
}

// =================================================================
// ACCOUNTING
// =================================================================

model FiscalPeriod {
  id        Int       @id @default(autoincrement())
  name      String
  year      Int
  month     Int
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime  @map("end_date") @db.Date
  status    String    @default("open") // open, closed
  closedAt  DateTime? @map("closed_at")
  closedById Int?     @map("closed_by_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  journals              Journal[]
  savingsTransactions   SavingsTransaction[]
  loans                 Loan[]
  loanPayments          LoanPayment[]
  cashBankTransactions  CashBankTransaction[]
  storeSales            StoreSale[]

  @@unique([year, month])
  @@map("fiscal_periods")
}

model Journal {
  id              Int      @id @default(autoincrement())
  journalNo       String   @unique @map("journal_no")
  branchId        Int      @map("branch_id")
  transactionDate DateTime @map("transaction_date") @db.Date
  description     String
  sourceType      String?  @map("source_type")
  sourceId        Int?     @map("source_id")
  periodId        Int      @map("period_id")
  isPosted        Boolean  @default(true) @map("is_posted")
  isAdjustment    Boolean  @default(false) @map("is_adjustment")
  isClosing       Boolean  @default(false) @map("is_closing")
  approvalId      Int?     @map("approval_id")
  createdById     Int      @map("created_by_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  branch              Branch               @relation(fields: [branchId], references: [id])
  period              FiscalPeriod         @relation(fields: [periodId], references: [id])
  createdBy           User                 @relation("JournalCreatedBy", fields: [createdById], references: [id])
  lines               JournalLine[]
  savingsTransactions SavingsTransaction[]
  loanDisbursements   Loan[]
  loanPayments        LoanPayment[]
  cashBankTransactions CashBankTransaction[]
  storeSales           StoreSale[]            @relation("StoreSaleJournal")

  @@map("journals")
}

model JournalLine {
  id          Int     @id @default(autoincrement())
  journalId   Int     @map("journal_id")
  accountId   Int     @map("account_id")
  debit       Decimal @default(0) @db.Decimal(15, 2)
  credit      Decimal @default(0) @db.Decimal(15, 2)
  description String?

  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id])

  @@map("journal_lines")
}

// =================================================================
// APPROVAL
// =================================================================

model ApprovalRequest {
  id             Int       @id @default(autoincrement())
  requestNo      String    @unique @map("request_no")
  type           String    // loan_application, savings_correction, etc
  referenceType  String    @map("reference_type")
  referenceId    Int       @map("reference_id")
  branchId       Int       @map("branch_id")
  amount         Decimal?  @db.Decimal(15, 2)
  description    String
  metadata       Json?
  status         String    @default("pending") // pending, approved, rejected
  requestedById  Int       @map("requested_by_id")
  requestedAt    DateTime  @map("requested_at")
  approvedById   Int?      @map("approved_by_id")
  approvedAt     DateTime? @map("approved_at")
  rejectedById   Int?      @map("rejected_by_id")
  rejectedAt     DateTime? @map("rejected_at")
  rejectionReason String?  @map("rejection_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  branch      Branch @relation(fields: [branchId], references: [id])
  requestedBy User   @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?  @relation("ApprovalApprovedBy", fields: [approvedById], references: [id])

  @@map("approval_requests")
}

// =================================================================
// UNIT TRANSACTIONS
// =================================================================

model UnitTransaction {
  id                  Int       @id @default(autoincrement())
  transactionNo       String    @unique @map("transaction_no")
  memberId            Int?      @map("member_id")
  unitType            String    @map("unit_type") // toko, play_station, fitness, coffe_latar, barbershop, carwash, resto, properti, simpan_pinjam
  description         String
  amount              Decimal   @db.Decimal(15, 2)
  loanAmount          Decimal   @default(0) @map("loan_amount") @db.Decimal(15, 2) // Porsi yang jadi tagihan piutang anggota
  transactionDate     DateTime  @map("transaction_date") @db.Date
  paymentMethod       String    @default("cash") @map("payment_method") // cash, qris, salary_cut
  isPaid              Boolean   @default(false) @map("is_paid")
  paidDate            DateTime? @map("paid_date") @db.Date
  notes               String?
  supportingDocPath   String?   @map("supporting_doc_path")
  // ── Status Void Workflow ──────────────────────────────────────────
  status              String    @default("completed") // completed, pending_void, voided
  voidRef             String?   @map("void_ref")           // transactionNo transaksi asli yang di-void
  voidReason          String?   @map("void_reason")
  voidRequestedById   Int?      @map("void_requested_by_id")
  voidRequestedAt     DateTime? @map("void_requested_at")
  voidedById          Int?      @map("voided_by_id")
  voidedAt            DateTime? @map("voided_at")
  // ── Anti-Manipulasi ───────────────────────────────────────────────
  securityHash        String?   @map("security_hash")      // SHA256(nrp+amount+transactionNo+timestamp)
  createdById         Int       @map("created_by_id")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  member    Member? @relation(fields: [memberId], references: [id])
  createdBy User    @relation("UnitTxCreatedBy", fields: [createdById], references: [id])

  @@index([memberId, status])
  @@index([unitType, transactionDate])
  @@index([status])
  @@map("unit_transactions")
}

// =================================================================
// TOKO (STORE) MANAGEMENT
// =================================================================

model StoreProduct {
  id        Int       @id @default(autoincrement())
  sku       String    @unique
  name      String
  category  String?
  unitType  String    @default("toko") @map("unit_type") // toko, resto, coffe_latar
  imageUrl  String?   @map("image_url") @db.Text // Base64 or external URL for product/menu image
  costPrice Decimal   @default(0) @map("cost_price") @db.Decimal(15, 2)
  sellPrice Decimal   @map("sell_price") @db.Decimal(15, 2)
  discountType String?   @map("discount_type")
  discountValue Decimal  @default(0) @map("discount_value") @db.Decimal(15, 2)
  stock     Int       @default(0) // Now acts as Total Stock
  stockGdg  Int       @default(0) @map("stock_gdg")
  stockToko Int       @default(0) @map("stock_toko")
  minStock  Int       @default(5) @map("min_stock")
  unit      String    @default("pcs")
  isService Boolean   @default(false) @map("is_service") // True for haircuts, generic washes, etc.
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  saleItems      StoreSaleItem[]
  stockMovements StoreStockMovement[]
  stockBatches   StockBatch[]

  @@map("store_products")
}

model StoreStockMovement {
  id          Int       @id @default(autoincrement())
  productId   Int       @map("product_id")
  type        String    // "in" | "out"
  quantity    Int
  reference   String?   // Contoh: Penjualan TK-..., Pengadaan, Retur
  notes       String?
  status      String    @default("active") // "active" | "voided"
  operatorId  Int?      @map("operator_id")
  voidedAt    DateTime? @map("voided_at")
  voidedById  Int?      @map("voided_by_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  reason      String?   // "sale" | "damaged" | "expired" | "internal_use" | "other" | "adjustment" | "transfer"
  reasonNote  String?   @map("reason_note")
  batchId     Int?      @map("batch_id")
  costAtTime  Decimal?  @map("cost_at_time") @db.Decimal(15, 2)

  product     StoreProduct @relation(fields: [productId], references: [id])
  operator    User?        @relation("stockMovementOperator", fields: [operatorId], references: [id])
  voidedBy    User?        @relation("stockMovementVoidedBy", fields: [voidedById], references: [id])
  batch       StockBatch?  @relation(fields: [batchId], references: [id])

  @@index([productId])
  @@index([type])
  @@map("store_stock_movements")
}

model StoreSale {
  id            Int       @id @default(autoincrement())
  saleNo        String    @unique @map("sale_no")
  memberId      Int?      @map("member_id")
  unitType      String    @default("toko") @map("unit_type") // toko, resto, coffe_latar
  customerName  String?   @map("customer_name")
  totalAmount   Decimal   @map("total_amount") @db.Decimal(15, 2)
  paymentMethod String    @default("cash") @map("payment_method")
  cashReceived  Decimal?  @map("cash_received") @db.Decimal(15, 2)
  changeAmount  Decimal?  @map("change_amount") @db.Decimal(15, 2)
  metadata      Json?     // Used for specialized POS inputs (e.g., table_no, ps_number, vehicle_plate) 
  journalId     Int?      @map("journal_id")
  periodId      Int?      @map("period_id")
  shiftId       Int?      @map("shift_id")
  createdById   Int       @map("created_by_id")
  cashierIdentityId Int?  @map("cashier_identity_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  member    Member?       @relation(fields: [memberId], references: [id])
  journal   Journal?      @relation("StoreSaleJournal", fields: [journalId], references: [id])
  period    FiscalPeriod? @relation(fields: [periodId], references: [id])
  createdBy User          @relation("StoreSaleCreatedBy", fields: [createdById], references: [id])
  shift     CashierShift? @relation(fields: [shiftId], references: [id])
  cashierIdentity CashierIdentity? @relation(fields: [cashierIdentityId], references: [id])
  items     StoreSaleItem[]

  @@index([unitType])
  @@index([createdAt])
  @@index([unitType, createdAt])
  @@index([paymentMethod])
  @@map("store_sales")
}

model StoreSaleItem {
  id        Int     @id @default(autoincrement())
  saleId    Int     @map("sale_id")
  productId Int     @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(15, 2)
  discount  Decimal @default(0) @db.Decimal(15, 2)
  subtotal  Decimal @db.Decimal(15, 2)
  costPrice Decimal? @map("cost_price") @db.Decimal(15, 2)

  sale    StoreSale    @relation(fields: [saleId], references: [id])
  product StoreProduct @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
  @@map("store_sale_items")
}

// =================================================================
// RECEIPTS (KWITANSI)
// =================================================================

model Receipt {
  id              Int       @id @default(autoincrement())
  receiptNo       String    @unique @map("receipt_no")
  memberId        Int       @map("member_id")
  type            String    // simpanan, pinjaman, angsuran, unit_transaction
  referenceNo     String?   @map("reference_no")
  amount          Decimal   @db.Decimal(15, 2)
  description     String
  receivedFrom    String    @map("received_from")
  paymentMethod   String    @default("cash") @map("payment_method")
  status          String    @default("draft") // draft, printed, void
  notes           String?
  receiptDate     DateTime  @map("receipt_date") @db.Date
  printedAt       DateTime? @map("printed_at")
  createdById     Int       @map("created_by_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  member    Member @relation(fields: [memberId], references: [id])
  createdBy User   @relation("ReceiptCreatedBy", fields: [createdById], references: [id])

  @@map("receipts")
}

// =================================================================
// ASSETS (ASET)
// =================================================================

model Asset {
  id                      Int       @id @default(autoincrement())
  code                    String    @unique
  name                    String
  category                String    // building, vehicle, equipment, furniture, computer, other
  acquisitionDate         DateTime  @map("acquisition_date") @db.Date
  acquisitionCost         Decimal   @map("acquisition_cost") @db.Decimal(15, 2)
  usefulLifeYears         Int       @map("useful_life_years")
  residualValue           Decimal   @default(0) @map("residual_value") @db.Decimal(15, 2)
  accumulatedDepreciation Decimal   @default(0) @map("accumulated_depreciation") @db.Decimal(15, 2)
  bookValue               Decimal   @map("book_value") @db.Decimal(15, 2)
  location                String?
  description             String?
  status                  String    @default("active") // active, disposed, under_maintenance
  disposedDate            DateTime? @map("disposed_date") @db.Date
  disposedValue           Decimal?  @map("disposed_value") @db.Decimal(15, 2)
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  @@map("assets")
}

// =================================================================
// ANNOUNCEMENTS (PENGUMUMAN)
// =================================================================

model Announcement {
  id          Int       @id @default(autoincrement())
  title       String
  content     String    @db.Text
  category    String    @default("info") // info, event, policy, promo
  isPinned    Boolean   @default(false) @map("is_pinned")
  status      String    @default("draft") // draft, published
  views       Int       @default(0)
  authorId    Int       @map("author_id")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  author User @relation("AnnouncementAuthor", fields: [authorId], references: [id])

  @@map("announcements")
}

// =================================================================
// AUDIT LOG (Enterprise-grade untuk Instansi Polisi)
// =================================================================

model AuditLog {
  id            Int       @id @default(autoincrement())
  timestamp     DateTime  @default(now())

  // User info (denormalized for immutability)
  userId        Int?      @map("user_id")
  userName      String    @map("user_name")
  userEmail     String?   @map("user_email")
  userRole      String    @map("user_role")
  sessionId     String?   @map("session_id")

  // Action info
  action        String    // LOGIN, LOGOUT, LOGIN_FAILED, CREATE, UPDATE, DELETE, VIEW, EXPORT, APPROVE, REJECT, IMPORT
  module        String    // Auth, Anggota, Simpanan, Pinjaman, Toko, Jurnal, Kas, Aset, Laporan, Master, User, Pengumuman
  description   String    @db.Text

  // Target entity
  targetId      String?   @map("target_id")    // ID of affected record
  targetType    String?   @map("target_type")  // Model name e.g. "Member", "Loan"

  // Data change tracking
  oldData       String?   @map("old_data") @db.Text   // JSON snapshot before change
  newData       String?   @map("new_data") @db.Text   // JSON snapshot after change

  // Request metadata
  ipAddress     String?   @map("ip_address")
  userAgent     String?   @map("user_agent") @db.Text
  requestMethod String?   @map("request_method")
  requestUrl    String?   @map("request_url") @db.Text

  // Result
  status        String    @default("success")  // success, failed, warning
  errorMessage  String?   @map("error_message") @db.Text

  // Metadata
  duration      Int?      // request duration in ms
  metadata      String?   @db.Text  // additional JSON metadata (MAC address, etc.)

  // Relation (nullable for system/anonymous events like failed login)
  user          User?     @relation("AuditLogUser", fields: [userId], references: [id])

  @@index([timestamp])
  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// =================================================================
// UNIT SERVICE PACKAGES
// Menyimpan daftar paket layanan & harga per unit usaha jasa.
// Menggantikan konstanta hardcoded (CARWASH_PACKAGES, dll) di kode.
// Admin unit bisa CRUD paket ini tanpa menyentuh source code.
// =================================================================
model UnitServicePackage {
  id          Int      @id @default(autoincrement())
  unitType    String   @map("unit_type")        // e.g. cuci_mobil, barbershop, fitness
  name        String                             // e.g. "Motor", "Potong Rambut Biasa"
  description String?  @db.Text                 // keterangan tambahan
  price       Decimal  @db.Decimal(15, 2)
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById Int?     @map("created_by_id")

  createdBy   User?    @relation(fields: [createdById], references: [id])

  @@index([unitType])
  @@index([isActive])
  @@map("unit_service_packages")
}
// =================================================================
// UNIT SETTINGS
// Menyimpan konfigurasi per unit (seperti QRIS base64) tanpa butuh FS upload.
// =================================================================
model UnitSetting {
  id          Int      @id @default(autoincrement())
  unitType    String   @unique @map("unit_type")
  qrisBase64  String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("unit_settings")
}

// =================================================================
// UPLOADED FILES (Stored as Base64 in DB — Vercel FS is read-only)
// Menyimpan file upload (receipt struk, foto bukti) di database
// karena Vercel serverless functions memiliki filesystem read-only.
// =================================================================
model UploadedFile {
  id          Int      @id @default(autoincrement())
  category    String   // "expense_receipt", "qris", "member_photo", etc.
  refId       String?  @map("ref_id")  // Reference ID (e.g. transactionNo, unitType)
  fileName    String   @map("file_name")
  mimeType    String   @map("mime_type")
  base64Data  String   @map("base64_data") @db.Text
  sizeBytes   Int      @map("size_bytes")
  uploadedById Int     @map("uploaded_by_id")
  createdAt   DateTime @default(now()) @map("created_at")

  uploadedBy  User     @relation("FileUploadedBy", fields: [uploadedById], references: [id])

  @@index([category, refId])
  @@map("uploaded_files")
}

// =================================================================
// PENGATURAN / KONFIGURASI SISTEM MENDALAM
// =================================================================

model SystemSetting {
  id          String   @id @default("global") // Singleton pattern: just use "global"
  shuConfig   Json     // Konfigurasi dinamis persentase SHU (berdasarkan AD ART)
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById Int?     @map("updated_by_id")

  @@map("system_settings")
}

// =================================================================
// SHIFT KASIR — Pencatatan shift buka/tutup kasir
// =================================================================

model CashierShift {
  id                Int       @id @default(autoincrement())
  userId            Int       @map("user_id")
  unitType          String    @map("unit_type")          // toko, cuci_mobil, barbershop, dll
  shiftName         String    @map("shift_name")         // "Pagi", "Siang", "Malam"
  startedAt         DateTime  @map("started_at")
  endedAt           DateTime? @map("ended_at")
  openingCash       Decimal   @default(0) @map("opening_cash") @db.Decimal(15, 2)
  closingCash       Decimal?  @map("closing_cash") @db.Decimal(15, 2)
  expectedCash      Decimal?  @map("expected_cash") @db.Decimal(15, 2)  // Auto-calculated
  totalSalesCash    Decimal   @default(0) @map("total_sales_cash") @db.Decimal(15, 2)
  totalSalesQris    Decimal   @default(0) @map("total_sales_qris") @db.Decimal(15, 2)
  totalSalesCredit  Decimal   @default(0) @map("total_sales_credit") @db.Decimal(15, 2)
  totalTransactions Int       @default(0) @map("total_transactions")
  cashDifference    Decimal?  @map("cash_difference") @db.Decimal(15, 2) // closingCash - expectedCash
  notes             String?
  closedByUserId    Int?      @map("closed_by_user_id") // Bisa ditutup oleh admin/operator
  cashierIdentityId Int?      @map("cashier_identity_id")
  status            String    @default("open")          // "open" | "closed"
  createdAt         DateTime  @default(now()) @map("created_at")

  user       User        @relation("CashierShiftUser", fields: [userId], references: [id])
  cashierIdentity CashierIdentity? @relation(fields: [cashierIdentityId], references: [id])
  storeSales StoreSale[]

  @@map("cashier_shifts")
}

// =================================================================
// CASHIER IDENTITIES (Sub-akun Kasir per Device)
// =================================================================

model CashierIdentity {
  id            Int       @id @default(autoincrement())
  parentUserId  Int       @map("parent_user_id")
  username      String    @db.VarChar(20)
  pin           String    @db.Text
  displayName   String    @map("display_name") @db.VarChar(50)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  parentUser    User      @relation(fields: [parentUserId], references: [id])
  shifts        CashierShift[]
  sales         StoreSale[]

  @@unique([parentUserId, username])
  @@map("cashier_identities")
}

// =================================================================
// APP SETTINGS (Key-Value Configuration)
// =================================================================

model AppSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  label     String?
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// =================================================================
// NOTIFICATIONS
// =================================================================

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String   // "low_stock" | "expiring_soon" | "batch_expired" | "stock_in" | "void_request" | "info"
  title     String
  message   String
  data      Json?    // payload: { productId, batchId, unitType, dll }
  isRead    Boolean  @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// =================================================================
// STOCK BATCHES (HPP & Batch Tracking)
// =================================================================

model StockBatch {
  id               Int       @id @default(autoincrement())
  productId        Int       @map("product_id")
  batchNo          String?   @map("batch_no")
  purchasePrice    Decimal   @map("purchase_price") @db.Decimal(15, 2)
  quantity         Int
  originalQuantity Int       @map("original_quantity")
  expiryDate       DateTime? @map("expiry_date")
  supplierName     String?   @map("supplier_name")
  receivedAt       DateTime  @default(now()) @map("received_at")
  location         String    @default("gudang")
  isActive         Boolean   @default(true) @map("is_active")
  notes            String?
  unitType         String    @default("toko") @map("unit_type")
  createdAt        DateTime  @default(now()) @map("created_at")

  product      StoreProduct        @relation(fields: [productId], references: [id])
  movements    StoreStockMovement[]

  @@index([productId, isActive, receivedAt])
  @@map("stock_batches")
}
