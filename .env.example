# =====================================================================
# PRIMKOPPOL — Environment Variable Reference
# =====================================================================
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# REQUIRED to run the app (web). Mobile has its own env (see mobile/.env.example).
#
# Production is deployed on Railway (service: koperasi-app, project: melodious-generosity).
# Railway System Variables (RAILWAY_*) are provided automatically — do NOT set them manually.
# =====================================================================

# ---------------------------------------------------------------
# 1. DATABASE (required)
# ---------------------------------------------------------------
# Runtime connection — use the POOLED Neon URL (postgres://...?pgbouncer=true ...)
# Production: keep in sync with Neon project "ep-little-feather-...".
DATABASE_URL="postgresql://user:password@localhost:5432/koperasi_db?sslmode=require"

# Migration/DDL connection — use the DIRECT (non-pooled) URL.
# Needed for prisma migrate; NOT required at runtime if you only db:push.
DIRECT_URL="postgresql://user:password@localhost:5432/koperasi_db?sslmode=require"

# ---------------------------------------------------------------
# 2. AUTH (NextAuth v5) (required)
# ---------------------------------------------------------------
# NextAuth v5 reads AUTH_SECRET. Railway also has legacy NEXTAUTH_SECRET/NEXTAUTH_URL set.
# Keep AUTH_SECRET == NEXTAUTH_SECRET so both work.
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="same-as-auth-secret-for-backwards-compat"
NEXTAUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------
# 3. APP (required)
# ---------------------------------------------------------------
NODE_ENV="development"

# Public API base consumed by client code (defaults to "/api" if unset).
# Set to the full origin for cross-origin builds (e.g. https://koperasi.up.railway.app).
NEXT_PUBLIC_API_URL=""

# Railway uses PORT internally; Next.js honors it. Not needed locally (Next default 3000).
PORT=""

# ---------------------------------------------------------------
# 5. LEGACY UAT/STAGING (reference only — .env.test.local, NOT committed)
# ---------------------------------------------------------------
# The old UAT env used Supabase + NEXT_PUBLIC_SUPABASE_* keys. These are
# NOT used by the current Railway app. Remove when legacy is decommissioned.
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=""

# ---------------------------------------------------------------
# 6. MOBILE (separate file, see mobile/.env)
# ---------------------------------------------------------------
# Mobile talks to the web API through this port (web and mobile in one monorepo).
EXPO_PUBLIC_API_PORT="3000"

# =====================================================================
# RAILWAY SYSTEM VARIABLES (auto-provided, do NOT set):
#   RAILWAY_PUBLIC_DOMAIN  e.g. koperasi.up.railway.app
#   RAILWAY_PRIVATE_DOMAIN
#   RAILWAY_PROJECT_NAME   melodious-generosity
#   RAILWAY_ENVIRONMENT_NAME production
#   RAILWAY_SERVICE_NAME   koperasi-app
#   RAILWAY_PROJECT_ID / ENVIRONMENT_ID / SERVICE_ID (UUIDs)
# =====================================================================
