{
  "expo": {
    "name": "PRIMKOPPOL RESOR LUMAJANG",
    "slug": "koperasi-primkoppol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A2A44"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.primkoppol.mobile"
    },
    "android": {
      "package": "com.primkoppol.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#1A2A44"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAdiRegistration",
      "expo-sharing",
      "expo-font",
      "expo-secure-store",
      "expo-image",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1A2A44",
          "sounds": [],
          "mode": "production"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3db40b2b-1d5f-4362-a61a-cacdaf712cd5"
      }
    },
    "owner": "violet666"
  }
}
