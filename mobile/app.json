{
  "expo": {
    "name": "Koperasi Primkoppol",
    "slug": "koperasi-primkoppol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/LogoPrimkoppol.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/LogoPrimkoppol.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A2A44"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.primkoppol.mobile"
    },
    "android": {
      "package": "com.primkoppol.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1A2A44",
        "foregroundImage": "./assets/LogoPrimkoppol.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
