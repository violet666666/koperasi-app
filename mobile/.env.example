# =====================================================================
# PRIMKOPPOL MOBILE — Environment Variable Reference
# =====================================================================
# Copy to `.env` and fill in real values.
#   cd mobile && cp .env.example .env
#
# Expo: EXPO_PUBLIC_* vars are inlined at build time. Changing them
# requires rebuilding the app (a new EAS build), NOT just a redeploy.
# =====================================================================

# The web/API server port the mobile app talks to.
#   local dev  -> 3000 (npm run dev, same machine)
#   staging    -> 3001 (see mobile/.env.staging)
EXPO_PUBLIC_API_PORT="3000"

# (Optional) Full API origin for production builds, if the app is served
# from a remote host. Leave empty to derive from EXPO_PUBLIC_API_PORT.
# EXPO_PUBLIC_API_URL="https://koperasi.up.railway.app"
